# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Settings → API Keys (or the Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_…). SERVER ONLY. Used for deleting a user's own account
# and for the daily proof-video cleanup job. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Where the app is served. Used in email links, invite links and on share cards.
# Local: http://localhost:3000 · Production: your Vercel URL or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token).
# Any long random string, e.g. `openssl rand -hex 32`. Optional locally.
CRON_SECRET=

# Show "Continue with Google" once the Google provider is set up in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── Optional, for tests only ──
# Disposable Postgres for `npm run test:db` (NOT your Supabase project; tests create and drop databases).
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# Admin connection for `npm run test:e2e:local`.
# STANDIN_ADMIN_URL=postgres://postgres@localhost:5432/postgres
# Use a system Chromium for Playwright instead of `npx playwright install`.
# PW_CHROMIUM_PATH=
# Run Playwright against an already-running app (e.g. pointed at your Supabase project).
# E2E_BASE_URL=http://127.0.0.1:3100
