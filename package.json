{
  "name": "liftrank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e-local.sh",
    "db:combined": "node scripts/combine-migrations.mjs",
    "db:push": "supabase db push",
    "catalog": "python3 scripts/catalog.py",
    "verify:supabase": "node --env-file=.env.local scripts/verify-supabase.mjs",
    "test:e2e:supabase": "bash scripts/e2e-supabase.sh",
    "cleanup:test-users": "node --env-file=.env.local scripts/cleanup-test-users.mjs",
    "cleanup:proofs": "node --env-file=.env.local scripts/cleanup-proofs.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
